{
  "name": "@rogerchappel/cfglint",
  "version": "0.1.0",
  "description": "Configuration file linter — no secrets, no drama",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "cfglint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "smoke": "bash scripts/smoke.sh",
    "release:check": "npm test && npm run build && npm run smoke && npm pack --dry-run",
    "package:smoke": "npm pack --dry-run"
  },
  "keywords": [
    "config",
    "lint",
    "security",
    "secrets",
    "json",
    "yaml",
    "toml",
    "env"
  ],
  "author": "Roger Chappel <roger@chappel.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/cfglint.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/cfglint/issues"
  },
  "homepage": "https://github.com/rogerchappel/cfglint#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "glob": "^10.3.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.0",
    "picocolors": "^1.0.0",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  }
}
